# Required for AI detection, market rates, and assistant
GEMINI_API_KEY=your_google_ai_studio_key_here

# Optional model override (default: gemini-3.5-flash)
# GEMINI_MODEL=gemini-3.1-pro

# Server
PORT=3000
NODE_ENV=development

# Production security (required when NODE_ENV=production)
# MC_API_TOKEN=long-random-token
# JWT_SECRET=at-least-32-characters-secret
# ALLOWED_ORIGINS=https://your-app.onrender.com

# Optional research / storage
# RESEARCH_ADMIN_TOKEN=
# RESEARCH_STORAGE=local
# RESEARCH_S3_BUCKET=
# RESEARCH_S3_REGION=
# RESEARCH_S3_ENDPOINT=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Rate limit (requests per minute per IP for AI endpoints)
# MC_AI_RATE_LIMIT=20

# Optional accuracy helpers (both are optionalDependencies)
#   npm install sharp          → high-contrast preprocess + real tile crops
#   npm install tesseract.js   → OCR scale-bar detection + label hard-corrections
# Client can still pass preprocess=false or ocr_assist=false per request.
